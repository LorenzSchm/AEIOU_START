# Copy to forwarder/.env (git-ignored). docker compose reads it automatically.
TEAM_API_KEY=
APP_PASSWORD=change-me
POSTGRES_USER=forwarder
POSTGRES_PASSWORD=forwarder
# Live switches. Keep false on every machine except the one running the real system.
POLLER_ENABLED=false
SEND_ENABLED=false
# Test mode against the real API without answering scored requests:
#   POLLER_ENABLED=true, SEND_ENABLED=true, CUSTOMER_REPLIES_ENABLED=false (carriers + rate desk only)
# Only the one live instance sets CUSTOMER_REPLIES_ENABLED=true.
CUSTOMER_REPLIES_ENABLED=false
# Set both to call OpenAI directly (not counted as team LLM cost at the 5U gateway). Empty = gateway.
LLM_BASE_URL=
LLM_API_KEY=
