# Build context is the repo root; keep it small. The Docker build needs only
# backend/ sources + backend/data + backend/cloudline + start-kit.

.git
**/.DS_Store

# The frontend image builds from the repo root too (frontend/Dockerfile.root); keep only its
# sources in the context, never its dependencies or build output.
frontend/node_modules
frontend/.next
frontend/.vercel

# Gradle/Java build output and the heavy runtime state dir (jars + sqlite snapshots).
backend/build
backend/*/build
backend/.gradle
backend/state
backend/__pycache__
**/*.class

# Secrets never belong in an image layer; pass them at run time instead.
.env
**/.env
**/.env.*
**/*.key

# Bulky docs/data at the repo root that the build never reads.
*.pdf
*.zip
*.pptx
*.docx
