# Copy to .env and fill in. Never commit .env.
TEAM_API_KEY=
# Optional Postgres mirror used by the dispatch backend.
DATABASE_URL=
# Optional full attachment fallback. Set to the installed edge-reader/lib directory.
DISPATCH_EDGE_READER_LIB=
# Allow scored gateway calls from the optional attachment reader.
DISPATCH_EDGE_READER_GATEWAY=false
